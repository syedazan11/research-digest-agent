# Copy this file to .env and fill in your key. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# LLM reranking (Day 2). Free key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# GitHub delivery (Day 4). Fine-grained token: this repo only, Issues: Read and write.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your-token-here
GITHUB_REPO=your-username/research-digest-agent
