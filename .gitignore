.env

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# local run output
data/*.db
# ...except the real DB: GitHub Actions commits it back after every weekly run (Day 5)
!data/digest.db
# SQLite side files: only exist mid-write, never commit them
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/candidates/
# data/digests/ gets un-ignored on Day 7, when GitHub Pages publishes it
data/digests/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
